{
  "name": "mothership",
  "version": "0.1.0",
  "main": "dist/lib/app.js",
  "types": "dist/types/app.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "clean": "rm -rf dist && rm -rf cdk.out",
    "format:check": "if-env SKIP_FORMAT=true || (prettier --check \"lib/**/*.{ts,tsx}\" && eslint \"lib/**/*.{ts,tsx}\")",
    "format:fix": "if-env SKIP_FORMAT=true || (prettier --write \"lib/**/*.{ts,tsx}\" && eslint --fix \"lib/**/*.{ts,tsx}\")"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^29.4.0",
    "@types/node": "18.11.18",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "aws-cdk": "2.64.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "if-env": "^1.0.4",
    "jest": "^29.4.1",
    "prettier": "^3.8.3",
    "ts-jest": "^29.0.5",
    "ts-node": "^10.9.1",
    "typescript": "~4.9.5"
  },
  "dependencies": {
    "aws-cdk-lib": "2.64.0",
    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  }
}
